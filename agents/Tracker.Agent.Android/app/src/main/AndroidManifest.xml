<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wi-Fi na tela de bloqueio: o aparelho precisa voltar a ficar online para receber o
         comando de Desbloquear da TI. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Tipo usado quando a localizacao nao esta permitida (ou o servico sobe do boot sem direito
         de uso em primeiro plano): sem ele o Android 14 derruba o servico e o bloqueio para. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Sem esta permissao o Android 10+ nao deixa o servico abrir a tela de bloqueio
         estando em segundo plano: e o que sustenta o bloqueio persistente. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Auto-atualizacao OTA sem loja: permite ao agente instalar o proprio APK novo. Sem
         Device Owner o usuario ainda confirma o dialogo do sistema na primeira vez. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Numero de serie e IMEI reais. maxSdkVersion=28 de proposito: do Android 10 em diante o
         sistema recusa a leitura a app comum (so Device Owner), entao pedir a permissao la seria
         incomodar o usuario por nada. -->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="28" />

    <application
        android:name=".TrackerApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_tracker"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrackerAgent">

        <activity
            android:name=".enrollment.EnrollmentActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hospeda o painel de Wi-Fi do sistema durante o bloqueio (PainelWifiActivity): invisivel,
             fora dos Recentes e sem afinidade (tarefa propria, nao traz o app para a frente). -->
        <activity
            android:name=".bloqueio.PainelWifiActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- singleInstance + excludeFromRecents: o usuario nao consegue "deixar de lado" a tela
             de bloqueio pelo historico de apps, e nunca existem duas instancias empilhadas. -->
        <activity
            android:name=".bloqueio.BloqueioActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:noHistory="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.TrackerAgent.Bloqueio" />

        <!-- location: so e usado em runtime quando a permissao existe (AgenteService escolhe o
             tipo). specialUse: agente de gestao que mantem o bloqueio remoto persistente — nao
             depende de permissao em runtime, entao o servico sobe sempre. -->
        <service
            android:name=".servico.AgenteService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Agente corporativo de gestao de ativos: mantem o bloqueio remoto do aparelho aplicado pela TI e recebe comandos do servidor." />
        </service>

        <receiver
            android:name=".admin.TrackerDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Resultado da sessao de instalacao da OTA (sucesso, falha ou confirmacao pendente). -->
        <receiver
            android:name=".atualizacao.ResultadoInstalacaoReceiver"
            android:exported="false" />

        <receiver
            android:name=".servico.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
