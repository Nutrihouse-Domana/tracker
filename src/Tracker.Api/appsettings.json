{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TrackerDb": "Server=localhost\\SQLEXPRESS;Database=TrackerDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "TermosDeUsoPath": "App_Data/termos-de-uso"
  },
  "Snmp": {
    "Habilitado": true,
    "IntervaloMinutos": 15,
    "TimeoutMs": 3000,
    "Porta": 161,
    "MaxParalelismo": 8,
    "LimiteSuprimentoPercentual": 15,
    "FalhasParaOffline": 2,
    "RetencaoDias": 730,
    "TentarV1": true
  }
}
